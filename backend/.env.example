# Application
MBA_APP_NAME="Model Bias Auditor"
MBA_LOG_LEVEL=INFO

# Database (SQLite by default; Docker Compose overrides with PostgreSQL)
MBA_DATABASE_URL=sqlite+aiosqlite:///./model_bias_auditor.db

# Auditing behaviour
MBA_WORKER_CONCURRENCY=4
MBA_DEFAULT_EVALUATOR_ID=composite-disparity
MBA_DISPARITY_WARNING_THRESHOLD=0.15
MBA_DISPARITY_CRITICAL_THRESHOLD=0.35
MBA_MIN_RESPONSE_TOKENS=5

# Below this response length the per-100-token rates become unstable, so findings are
# flagged low-signal and their confidence is capped.
MBA_MIN_COMPARABLE_TOKENS=150
MBA_LOW_SIGNAL_CONFIDENCE_CAP=0.4
